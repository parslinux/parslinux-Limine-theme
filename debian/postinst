#!/bin/sh
set -e

case "$1" in
    configure)
        if [ -d "/boot/limine" ]; then
            mkdir -p /boot/limine/themes/parslinux
            cp -rf /usr/share/limine/themes/parslinux/* /boot/limine/themes/parslinux/ 2>/dev/null || true
        fi
        if [ -d "/boot/efi/limine" ]; then
            mkdir -p /boot/efi/limine/themes/parslinux
            cp -rf /usr/share/limine/themes/parslinux/* /boot/efi/limine/themes/parslinux/ 2>/dev/null || true
        fi
        if [ -x /usr/sbin/update-limine ]; then
            /usr/sbin/update-limine || true
        fi
    ;;
esac

#DEBHELPER#

exit 0
